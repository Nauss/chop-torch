<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/safe_area" android:layout_width="match_parent" android:layout_height="match_parent"
    tools:ignore="MergeRootFrame,UselessParent"
    android:clipChildren="true" android:clipToPadding="true">
    <!-- Required: MainActivity pads this non-scrolling parent with live window
         insets. Merging it would let the scroll viewport cover system bars. -->
    <ScrollView android:id="@+id/scroll" android:layout_width="match_parent" android:layout_height="match_parent"
        android:fillViewport="true" android:clipToPadding="true">
    <LinearLayout android:id="@+id/content" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal" android:orientation="vertical" android:padding="24dp">
        <TextView style="@style/Type.Headline" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center_vertical" android:layout_marginTop="16dp" android:drawableStart="@drawable/ic_torch"
            android:drawablePadding="12dp" android:text="@string/app_name" android:accessibilityHeading="true" />
        <TextView style="@style/Type.Body" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="20dp" android:text="@string/intro" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
            android:layout_marginTop="32dp" android:padding="20dp" android:background="@drawable/surface_panel">
            <Switch android:id="@+id/activation" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:minHeight="56dp" android:text="@string/detection" android:textAppearance="@style/Type.Title"
                android:switchPadding="16dp" android:showText="false"
                android:thumbTint="@color/switch_thumb" android:trackTint="@color/switch_track" />
            <TextView android:id="@+id/state" style="@style/Type.Body.Emphasis"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"
                android:accessibilityLiveRegion="polite" />
            <TextView android:id="@+id/detail" style="@style/Type.Body" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="4dp" android:accessibilityLiveRegion="polite" />
            <Button android:id="@+id/recovery" style="@style/Action.Text" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="@string/notification_settings"
                android:layout_marginTop="12dp" android:visibility="gone" />
        </LinearLayout>
        <TextView android:id="@+id/sensitivity_label" style="@style/Type.Title" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="32dp" android:text="@string/sensitivity"
            android:accessibilityHeading="true" android:labelFor="@id/sensitivity" />
        <TextView android:id="@+id/sensitivity_value" style="@style/Type.Body.Emphasis" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="8dp" android:importantForAccessibility="no" />
        <SeekBar android:id="@+id/sensitivity" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="48dp" android:max="100" android:contentDescription="@string/sensitivity" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
            android:importantForAccessibility="noHideDescendants">
            <TextView style="@style/Type.Label" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:text="@string/lighter" />
            <TextView style="@style/Type.Label" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/stronger" />
        </LinearLayout>
        <TextView style="@style/Type.Body" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="@string/sensitivity_hint" />
        <Button android:id="@+id/help_button" style="@style/Action.Text" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="32dp" android:text="@string/help_open" />
        <LinearLayout android:id="@+id/help" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:visibility="gone">
            <TextView style="@style/Type.Title" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="24dp" android:text="@string/help_gesture_title" android:accessibilityHeading="true" />
            <TextView style="@style/Type.Body" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:text="@string/help_gesture" />
            <TextView style="@style/Type.Title" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="24dp" android:text="@string/help_limits_title" android:accessibilityHeading="true" />
            <TextView style="@style/Type.Body" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:text="@string/help_limits" />
            <TextView android:id="@+id/battery_info" style="@style/Type.Body" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="16dp" />
            <Button android:id="@+id/battery_settings" style="@style/Action.Text" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/battery_settings" />
            <TextView style="@style/Type.Body" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="24dp" android:text="@string/privacy" />
            <TextView android:id="@+id/version" style="@style/Type.Label" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="16dp" />
            <Button android:id="@+id/source" style="@style/Action.Text" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/source" />
        </LinearLayout>
    </LinearLayout>
    </ScrollView>
</FrameLayout>
